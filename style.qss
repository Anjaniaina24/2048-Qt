Game2048#game {
    background: #1C1B29;
}

QLabel#scoreLabel, QLabel#bestScoreLabel {
    background: #2a2838;
    color: white;
    font: bold 16px "Arial";
    border-radius: 6px;
    padding: 5px 0px;
}

QWidget#gridWidget {
    background: #2a2838;
    border-radius: 10px;
}

QPushButton#menuButton {
    background-color: #8f7a66;
    border-radius: 8px;
    color: white;
    font: bold 14px "Arial";
    padding: 5px 10px;
    border: none;
}
QPushButton#menuButton:hover {
    background-color: #9f8b76;
}
QPushButton#menuButton:pressed {
    background-color: #7a6a56;
}

QWidget#menuWidget {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #1C1B29, stop:1 #2a2838);
}

QLabel#titleLabel {
    font: 900 72px "Arial Black";
    color: #f2e9c7;
    padding: 20px;
    margin-bottom: 20px;
    background: transparent;
}

QPushButton#playButton, QPushButton#quitButton {
    background-color: #8f7a66;
    border: none;
    border-radius: 30px;
    color: white;
    font: bold 22px "Arial";
    padding: 10px;
}

QPushButton#playButton:hover, QPushButton#quitButton:hover {
    background-color: #9f8b76;
}

QPushButton#playButton:pressed, QPushButton#quitButton:pressed {
    background-color: #7a6a56;
}

QPushButton#quitButton {
    background-color: #e74c3c;
}

QPushButton#quitButton:hover {
    background-color: #c0392b;
}

QPushButton#quitButton:pressed {
    background-color: #a93226;
}